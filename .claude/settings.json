{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(uv sync --locked)",
      "Bash(uv run python manage.py check)",
      "Bash(uv run python manage.py check *)",
      "Bash(uv run python manage.py makemigrations --check --dry-run)",
      "Bash(uv run python manage.py makemigrations --check --dry-run *)",
      "Bash(uv run python manage.py test)",
      "Bash(uv run python manage.py test *)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff check *)",
      "Bash(uv run black --check *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-file-edit.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-prohibition-language.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-secrets.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You are a verification gate for a coding session. Hook input: $ARGUMENTS\n\nDecide whether this turn may end.\n\nBlock ONLY when ALL of these hold:\n1. This turn modified source code (not only markdown, docs/, .claude/ or config files).\n2. No test, build, lint, or type-check command was run after the last code modification.\n3. No user message in this turn asked to skip or defer verification.\n\nWhen any of the three is uncertain, allow. Turns that only investigate, answer questions, run commands, or edit documentation must always be allowed.\n\nOutput contract — follow it exactly. Respond with a single JSON object and nothing else: no explanation, no preamble, no code fences.\n- To allow: {\"ok\": true}\n- To block: {\"ok\": false, \"reason\": \"<name the verification command that should run>\"}",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
