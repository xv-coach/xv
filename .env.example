# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

# DJANGO
# Generate a new secret key for every environment (never reuse the old key
# that was hardcoded in settings.py; it is public in git history):
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=change-me
# Set to 0 in production.
DJANGO_DEBUG=1
# Comma separated, e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated origins incl. scheme, e.g. https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SOURCE=./src
PROJECT_ENV=development
# Host port for the django (gunicorn) container.
DJANGO_HOST_PORT=8000
# Extra gunicorn options; --reload restarts on code changes (development only).
GUNICORN_CMD_ARGS=--reload

# POSTGRESQL (used by both the postgres container and Django)
POSTGRES_DB=xv_rugby
POSTGRES_USER=xv_rugby
POSTGRES_PASSWORD=change-me
# DB_HOST / DB_PORT are set to postgres:5432 by docker-compose for the django
# service; set them here only when running Django outside docker.
DB_HOST=localhost
DB_PORT=5432
VOLUMES_DRIVER=local
