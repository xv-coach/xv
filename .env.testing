# Sample values for running docker compose in tests (cp .env.testing .env). Throwaway values, not secrets.
DJANGO_SECRET_KEY=ci-only-not-a-secret-key-do-not-use-anywhere-else
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SOURCE=./src
STATIC_FILES=./static
PROJECT_ENV=development

POSTGRES_DB=xv_rugby
POSTGRES_USER=xv_rugby
POSTGRES_PASSWORD=ci-only-password
DB_HOST=localhost
DB_PORT=5432
VOLUMES_DRIVER=local

NGINX_HOST_HTTP_PORT=8000
NGINX_CONF_PATH=./containers/nginx/xv_nginx.conf
NGINX_UWSGI_PARAMS=./containers/nginx/uwsgi_params
NGINX_LOG=./log/nginx
